generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  name       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  portfolios Portfolio[]

  @@map("users")
}

model Portfolio {
  id              String    @id @default(uuid())
  userId          String
  name            String
  description     String?
  totalCapital    Decimal   @default(0) @db.Decimal(18, 2)
  budgetYearStart DateTime? @db.Date
  budgetYearEnd   DateTime? @db.Date
  currency        String    @default("USD")
  // Bucket ratios — must sum to 1.0
  coreRatio       Decimal   @default(0.60) @db.Decimal(5, 4)
  dipRatio        Decimal   @default(0.30) @db.Decimal(5, 4)
  crashRatio      Decimal   @default(0.10) @db.Decimal(5, 4)
  // How many DCA weeks per year (Excel uses 48, not 52)
  dcaWeeksPerYear Int       @default(48)
  isActive        Boolean   @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  allocations       Allocation[]
  coreStocks        CoreStock[]
  investors         Investor[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategySnapshots StrategySnapshot[]
  strategyRules     StrategyRule[]
  transactions      Transaction[]
  weeklyBudgets     WeeklyBudget[]
  budgetPresets     BudgetPreset[]

  @@index([userId])
  @@map("portfolios")
}

model BudgetPreset {
  id              String    @id @default(uuid())
  portfolioId     String
  name            String
  totalCapital    Decimal   @db.Decimal(18, 2)
  budgetYearStart DateTime? @db.Date
  budgetYearEnd   DateTime? @db.Date
  createdAt       DateTime  @default(now())
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  stocks          BudgetPresetStock[]

  @@index([portfolioId])
  @@map("budget_presets")
}

model BudgetPresetStock {
  id               String       @id @default(uuid())
  budgetPresetId   String
  symbol           String
  companyName      String?
  targetPercentage Decimal      @db.Decimal(5, 2)
  isAggressive     Boolean      @default(false)
  fiftyTwoWeekHigh Decimal?     @db.Decimal(18, 4)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  budgetPreset     BudgetPreset @relation(fields: [budgetPresetId], references: [id], onDelete: Cascade)

  @@unique([budgetPresetId, symbol])
  @@index([budgetPresetId])
  @@map("budget_preset_stocks")
}

model CoreStock {
  id          String    @id @default(uuid())
  portfolioId String
  symbol      String
  displayName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@index([portfolioId])
  @@map("core_stocks")
}

model StrategyRule {
  id                   String    @id @default(uuid())
  portfolioId          String
  symbol               String
  dipPercent           Int       // 10, 15, 20, 30 (thresholds from 52wHigh)
  // Multiplier applied to weeklyDCA: 1, 3, or 5
  buyMultiplier        Int       @default(1)
  // 1 = weekly dip trigger active at this level; 0 = no trigger
  weeklyDipMultiplier  Int       @default(0)
  portfolio            Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol, dipPercent])
  @@index([portfolioId])
  @@index([portfolioId, symbol])
  @@map("strategy_rules")
}

model Allocation {
  id                    String    @id @default(uuid())
  portfolioId           String
  symbol                String
  companyName           String?
  targetPercentage      Decimal   @db.Decimal(5, 2)
  // Whether to use aggressive multipliers (e.g. VONG ETF: 3× at 15%, 5× at 20%)
  isAggressive          Boolean   @default(false)
  // Reference high for threshold calculations (manually set, not auto-updated)
  fiftyTwoWeekHigh      Decimal?  @db.Decimal(18, 4)
  fiftyTwoWeekHighUpdatedAt DateTime?
  // Computed allocation fields (recalculated when budget/ratios change)
  allocationUSD         Decimal   @default(0) @db.Decimal(18, 2)
  coreBucketUSD         Decimal   @default(0) @db.Decimal(18, 2)
  dipBucketUSD          Decimal   @default(0) @db.Decimal(18, 2)
  crashBucketUSD        Decimal   @default(0) @db.Decimal(18, 2)
  monthlyDCA            Decimal   @default(0) @db.Decimal(18, 2)
  weeklyDCA             Decimal   @default(0) @db.Decimal(18, 2)
  // Bucket usage tracking
  coreUsedUSD           Decimal   @default(0) @db.Decimal(18, 2)
  dipUsedUSD            Decimal   @default(0) @db.Decimal(18, 2)
  crashUsedUSD          Decimal   @default(0) @db.Decimal(18, 2)
  coreRemainingUSD      Decimal   @default(0) @db.Decimal(18, 2)
  dipRemainingUSD       Decimal   @default(0) @db.Decimal(18, 2)
  crashRemainingUSD     Decimal   @default(0) @db.Decimal(18, 2)
  // Position tracking
  sharesOwned           Decimal   @default(0) @db.Decimal(18, 6)
  avgCostBasis          Decimal   @default(0) @db.Decimal(18, 4)
  investedValue         Decimal   @default(0) @db.Decimal(18, 2)
  // Intra-week dip trigger tracking
  lastWeeklyBuyPrice    Decimal?  @db.Decimal(18, 4)
  lastWeeklyBuyDate     DateTime? @db.Date
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  portfolio             Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
  @@index([portfolioId])
  @@index([symbol])
  @@map("allocations")
}

model PriceDaily {
  id               String   @id @default(uuid())
  symbol           String
  date             DateTime @db.Date
  open             Decimal? @db.Decimal(18, 4)
  high             Decimal? @db.Decimal(18, 4)
  low              Decimal? @db.Decimal(18, 4)
  close            Decimal  @db.Decimal(18, 4)
  volume           BigInt?
  fiftyTwoWeekHigh Decimal? @db.Decimal(18, 4)
  fiftyTwoWeekLow  Decimal? @db.Decimal(18, 4)
  createdAt        DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
  @@index([symbol])
  @@map("prices_daily")
}

model Transaction {
  id          String          @id @default(uuid())
  portfolioId String
  symbol      String
  type        TransactionType
  price       Decimal         @db.Decimal(18, 4)
  quantity    Decimal         @db.Decimal(18, 6)
  total       Decimal         @db.Decimal(18, 2)
  fees        Decimal         @default(0) @db.Decimal(18, 2)
  notes       String?
  date        DateTime        @db.Date
  executedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([symbol])
  @@index([date])
  @@index([portfolioId, symbol])
  @@map("transactions")
}

model WeeklyBudget {
  id              String    @id @default(uuid())
  portfolioId     String
  weekStartDate   DateTime  @db.Date
  plannedAmount   Decimal   @db.Decimal(18, 2)
  usedAmount      Decimal   @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal   @db.Decimal(18, 2)
  carryForward    Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, weekStartDate])
  @@index([portfolioId])
  @@index([weekStartDate])
  @@map("weekly_budgets")
}

model StrategySnapshot {
  id          String    @id @default(uuid())
  portfolioId String
  asOfDate    DateTime  @db.Date
  totalBudget Decimal   @db.Decimal(18, 2)
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  buyPlans    BuyPlan[]
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([asOfDate])
  @@map("strategy_snapshots")
}

model BuyPlan {
  id                String           @id @default(uuid())
  snapshotId        String
  symbol            String
  currentPrice      Decimal          @db.Decimal(18, 4)
  fiftyTwoWeekHigh  Decimal          @db.Decimal(18, 4)
  dipPercentage     Decimal          @db.Decimal(5, 2)
  dipLevelTriggered DipLevel
  suggestedPrice    Decimal          @db.Decimal(18, 4)
  suggestedQuantity Decimal          @db.Decimal(18, 6)
  capitalRequired   Decimal          @db.Decimal(18, 2)
  bucketUsed        BucketType
  reason            String
  priority          Int              @default(0)
  isApproved        Boolean          @default(false)
  isExecuted        Boolean          @default(false)
  executedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  snapshot          StrategySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([symbol])
  @@map("buy_plans")
}

model GlobalConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_config")
}

model Investor {
  id                 String    @id @default(uuid())
  portfolioId        String
  name               String
  contributionAmount Decimal   @default(0) @db.Decimal(18, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  portfolio          Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("investors")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  FEE
}

enum DipLevel {
  NORMAL_DCA
  LIGHT_DIP
  MODERATE_DIP
  DIP_BUCKET
  CRASH_BUCKET
}

enum BucketType {
  CORE
  DIP
  CRASH
}
